#.env.example
# WebNode Framework — Environment Config
# Copy this to .env and customize

# Server
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Security
# SECRET_KEY is auto-generated
# in .secret_key file

# Environment Mode
# Options: development, production
# WARNING: In production, Node Editor
# (port 8080) is automatically locked!
# This prevents Remote Code Execution.
ENV=development

# Database
DB_NAME=db.sqlite3
